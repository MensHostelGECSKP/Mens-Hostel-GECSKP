# URL pointing to the backend Express API server
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Window constraints matching backend configuration (in days)
# Default: 7 days in advance
NEXT_PUBLIC_ATTENDANCE_WINDOW_DAYS=7

# UTC hour representing daily marking lock (e.g. 19 = 19:00 UTC / 12:30 AM IST)
# Default: 19 (which locks marking for the next day at 12:30 AM IST)
NEXT_PUBLIC_ATTENDANCE_DEADLINE_HOUR=19
