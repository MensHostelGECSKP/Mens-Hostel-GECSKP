# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/mens-hostel

# Auth
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-jwt-refresh-secret

# Frontend
FRONTEND_URL=http://localhost:3000

# Email (optional — forgot password)
# Gmail: use an App Password (myaccount.google.com/apppasswords), not your login password.
# Port 587 + SMTP_SECURE=false uses STARTTLS (required on Render/Railway/Vercel).
# Port 465 + SMTP_SECURE=true uses implicit TLS (works locally but blocked by most cloud hosts).
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Mess bill storage configuration
MESS_BILL_STORAGE_PROVIDER=local # 'google-drive' or 'local'
MESS_BILL_UPLOAD_MAX_MB=10
MESS_BILL_REMINDER_CRON=0 9 * * *
MESS_BILL_REMINDER_TZ=Asia/Kolkata

# Google Drive API configuration (required only if provider is google-drive)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# Web Push Notifications (VAPID keys)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-email@example.com
