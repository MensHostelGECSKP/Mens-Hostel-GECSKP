# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/mens-hostel

# Auth
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-jwt-refresh-secret

# Frontend
FRONTEND_URL=http://localhost:3000

# Email (optional — forgot password)
EMAIL_USER=
EMAIL_PASS=

# Mess bill storage (local filesystem)
# MESS_BILL_STORAGE_DIR=uploads/mess-bills
MESS_BILL_UPLOAD_MAX_MB=10
MESS_BILL_REMINDER_CRON=0 9 * * *
MESS_BILL_REMINDER_TZ=Asia/Kolkata
